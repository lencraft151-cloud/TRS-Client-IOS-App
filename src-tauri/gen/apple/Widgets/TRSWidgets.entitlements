<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Widget-Erweiterung: App-Gruppe mit der App (TRS_APP_GROUP aus Signing.xcconfig) – darüber sieht das Widget die
  Instanzliste. Xcode legt die Gruppe bei automatischer Signatur selbst an.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TRS_APP_GROUP)</string>
	</array>
</dict>
</plist>
