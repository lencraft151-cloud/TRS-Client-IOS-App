<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Volle Entitlements (bezahlter Apple-Developer-Account): mehr Arbeitsspeicher und Adressraum für die JVM.
  Xcode legt die passenden Capabilities in der App-ID an; get-task-allow (für JIT) setzt Xcode bei
  Development-Signatur selbst. Ohne bezahlten Account: in Signing.xcconfig TRS_ENTITLEMENTS auf
  trs-launcher_iOS-basic.entitlements stellen.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
</dict>
</plist>
